{% comment %}
  MI AMOR PARIS — Footer.

  Four-column layout following the pattern used by most established retail
  brands: brand + social, two link columns, contact block, then a newsletter
  strip and a legal bar.

  Links are editable in the theme editor. Policy links point at Shopify's
  NATIVE policy URLs (/policies/...), which are generated from
  Settings → Policies — the legally correct place for them to live.
{% endcomment %}

<footer class="mi-footer">
  <div class="mi-footer__grid">

    {%- comment -%} Column 1 — brand {%- endcomment -%}
    <div class="mi-footer__brand">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name }}"
          class="mi-footer__logo"
          width="180" height="60" loading="lazy"
        >
      {%- else -%}
        <p class="mi-footer__wordmark">{{ shop.name }}</p>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="mi-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      <ul class="mi-footer__social" role="list">
        {%- if section.settings.instagram != blank -%}
          <li><a href="{{ section.settings.instagram }}" aria-label="Instagram" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a></li>
        {%- endif -%}
        {%- if section.settings.facebook != blank -%}
          <li><a href="{{ section.settings.facebook }}" aria-label="Facebook" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z"/></svg></a></li>
        {%- endif -%}
        {%- if section.settings.whatsapp != blank -%}
          <li><a href="{{ section.settings.whatsapp }}" aria-label="WhatsApp" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm0 16.4c-1.4 0-2.8-.4-4-1.1l-.3-.2-2.7.7.7-2.6-.2-.3A7.4 7.4 0 1 1 12 19.4zm4-5.5c-.2-.1-1.3-.7-1.5-.7-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6 6 0 0 1-3-2.6c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.4c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.4c.1.1 1.6 2.5 4 3.5 1.5.6 2 .7 2.8.6.4-.1 1.3-.5 1.5-1.1.2-.5.2-1 .1-1.1l-.4-.2z"/></svg></a></li>
        {%- endif -%}
      </ul>
    </div>

    {%- comment -%} Columns 2 & 3 — link lists {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'links' -%}
        <nav class="mi-footer__col" {{ block.shopify_attributes }} aria-labelledby="MiFooterCol{{ forloop.index }}">
          <h2 class="mi-footer__heading" id="MiFooterCol{{ forloop.index }}">{{ block.settings.heading }}</h2>
          <ul class="mi-footer__links" role="list">
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- assign labels = block.settings.labels | split: '|' -%}
              {%- assign urls = block.settings.urls | split: '|' -%}
              {%- for label in labels -%}
                <li><a href="{{ urls[forloop.index0] | default: '#' }}">{{ label }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Column 4 — contact {%- endcomment -%}
    <div class="mi-footer__col mi-footer__contact">
      <h2 class="mi-footer__heading">{{ section.settings.contact_heading }}</h2>

      {%- if section.settings.address != blank -%}
        <p><span class="mi-footer__label">Address:</span> {{ section.settings.address }}</p>
      {%- endif -%}

      {%- if section.settings.phone != blank -%}
        <p>
          <span class="mi-footer__label">Phone:</span>
          <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}">{{ section.settings.phone }}</a>
        </p>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <p>
          <span class="mi-footer__label">Email:</span>
          <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        </p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Also available on — marketplaces {%- endcomment -%}
  {%- if section.settings.amazon != blank or section.settings.myntra != blank or section.settings.flipkart != blank -%}
    <div class="mi-footer__shops">
      <p class="mi-footer__shops-heading">{{ section.settings.shops_heading }}</p>
      <ul class="mi-footer__shops-list" role="list">
        {%- if section.settings.amazon != blank -%}<li><a href="{{ section.settings.amazon }}" rel="noopener" target="_blank">Amazon</a></li>{%- endif -%}
        {%- if section.settings.myntra != blank -%}<li><a href="{{ section.settings.myntra }}" rel="noopener" target="_blank">Myntra</a></li>{%- endif -%}
        {%- if section.settings.flipkart != blank -%}<li><a href="{{ section.settings.flipkart }}" rel="noopener" target="_blank">Flipkart</a></li>{%- endif -%}
      </ul>
    </div>
  {%- endif -%}

  {%- comment -%} Newsletter strip {%- endcomment -%}
  {%- if section.settings.show_newsletter -%}
    <div class="mi-footer__news">
      <div class="mi-footer__news-copy">
        <h2 class="mi-footer__heading">{{ section.settings.newsletter_heading }}</h2>
        <p>{{ section.settings.newsletter_copy }}</p>
      </div>
      {%- form 'customer', class: 'mi-footer__news-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="MiFooterEmail">Email</label>
        <input
          type="email"
          name="contact[email]"
          id="MiFooterEmail"
          placeholder="Your email address"
          autocomplete="email"
          required
        >
        <button type="submit">Subscribe</button>
        {%- if form.posted_successfully? -%}
          <p class="mi-footer__news-ok">Thank you — you're on the list.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  {%- comment -%} Legal bar {%- endcomment -%}
  <div class="mi-footer__bar">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <ul class="mi-footer__legal" role="list">
      <li><a href="/policies/privacy-policy">Privacy</a></li>
      <li><a href="/policies/terms-of-service">Terms</a></li>
      <li><a href="/policies/refund-policy">Refunds</a></li>
    </ul>
  </div>
</footer>

{{ 'mi-footer.css' | asset_url | stylesheet_tag }}

<style>
  .mi-footer__social { gap: 14px; }
  .mi-footer__social a { width: 52px; height: 52px; border-width: 1.5px; }
  .mi-footer__social svg { display: block; }
  .mi-footer__shops { max-width: 1400px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; padding: 1.5rem 0; border-top: 1px solid rgba(255,255,255,.08); }
  .mi-footer__shops-heading { font-family: "Cormorant Garamond", Georgia, serif; font-style: italic; font-size: 1.2rem; color: #d4af6e; margin: 0; }
  .mi-footer__shops-list { display: flex; flex-wrap: wrap; gap: .6rem; list-style: none; padding: 0; margin: 0; }
  .mi-footer__shops-list a { display: inline-block; padding: .65rem 1.4rem; border: 1px solid rgba(212,175,110,.55); border-radius: 999px; color: #f2efe9; text-decoration: none; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; transition: background .28s ease, color .28s ease, border-color .28s ease; }
  .mi-footer__shops-list a:hover { background: #d4af6e; border-color: #d4af6e; color: #000; }
  @media screen and (max-width: 599px) {
    .mi-footer__social a { width: 46px; height: 46px; }
    .mi-footer__shops { flex-direction: column; align-items: flex-start; }
  }
</style>

{% schema %}
{
  "name": "Mi Amor Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The art of fragrance, made in the spirit of Paris." },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp" },
    { "type": "header", "content": "Also available on" },
    { "type": "text", "id": "shops_heading", "label": "Heading", "default": "Also available on" },
    { "type": "url", "id": "amazon", "label": "Amazon store link" },
    { "type": "url", "id": "myntra", "label": "Myntra store link" },
    { "type": "url", "id": "flipkart", "label": "Flipkart store link" },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Join the Mi Amor list" },
    { "type": "text", "id": "newsletter_copy", "label": "Copy", "default": "New fragrances, private launches and the occasional very good offer." }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick Links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Optional. If set, this replaces the manual list below." },
        { "type": "textarea", "id": "labels", "label": "Link labels", "info": "Separate with |", "default": "About Us|Contact Us|Product Categories|FAQs" },
        { "type": "textarea", "id": "urls", "label": "Link URLs", "info": "Separate with |, same order as labels", "default": "/pages/about-us|/pages/contact|/collections/all|/pages/faqs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mi Amor Footer",
      "blocks": [{ "type": "links" }, { "type": "links" }]
    }
  ]
}
{% endschema %}
